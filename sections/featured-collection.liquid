{{ 'featured-collection.css' | asset_url | stylesheet_tag }}

<section class="featured-products">
  <div class="featured-products__header">
    <p class="featured-products__subtitle">OUR COLLECTION</p>

    <h2 class="featured-products__title">Featured Products</h2>

    <p class="featured-products__description">Discover our latest and most popular products.</p>
  </div>

  <div class="products-grid">
    {% for product in collection.products limit: section.settings.products_to_show %}
      <div class="product-card">
        <div class="product-card__image">

          <img
            src="{{ product.featured_image | image_url: width: 600 }}"
            alt="Product Name"
            width="600"
            height="700"
          >

          <span class="product-card__badge"> Sale </span>
        </div>

        <div class="product-card__content">
          <p class="product-card__vendor">Brand Name</p>

          <h3 class="product-card__title">Classic Cotton Shirt</h3>

          <div class="product-card__price">
            <span class="product-card__price--sale"> $49.00 </span>

            <span class="product-card__price--compare"> $69.00 </span>
          </div>

          <button class="product-card__button">Add to Cart</button>
        </div>
      </div>
    {% endfor %}
  </div>
</section>
