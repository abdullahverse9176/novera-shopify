{{ 'featured-collection.css' | asset_url | stylesheet_tag }}

<section class="featured-products">
  <div class="featured-products__header">
    <p class="featured-products__subtitle">OUR COLLECTION</p>

    <h2 class="featured-products__title">Featured Products</h2>

    <p class="featured-products__description">Discover our latest and most popular products.</p>
  </div>

  <div class="products-grid">
    {% for product in collection.products limit: section.settings.products_to_show %}
      <div class="product-card">
        <div class="product-card__image">
          <img
            src="{{ product.featured_image | image_url: width: 600 }}"
            alt="Product Name"
            width="600"
            height="700"
          >

          <span class="product-card__badge"> Sale </span>
        </div>

        <div class="product-card__content">
          <p class="product-card__vendor">Brand Name</p>

          <h3 class="product-card__title">Classic Cotton Shirt</h3>

          <div class="product-card__price">
            <span class="product-card__price--sale"> {{ product.price | money }} </span>

            <span class="product-card__price--compare">
              {% if product.compare_at_price > product.price %}
                <span class="product-card__price--sale">
                  {{ product.price | money }}
                </span>

                <span class="product-card__price--compare">
                  {{ product.compare_at_price | money }}
                </span>

              {% else %}
                <span class="product-card__price--sale">
                  {{ product.price | money }}
                </span>
              {% endif %}
            </span>
          </div>

          <button class="product-card__button">Add to Cart</button>
        </div>
      </div>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Featured Collection",

  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "OUR COLLECTION"
    },

    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured Products"
    },

    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Discover our latest and most popular products."
    },

    {
      "type": "collection",
      "id": "collection",
      "label": "Select Collection"
    },

    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    }
  ],

  "presets": [
    {
      "name": "Featured Collection"
    }
  ]
}
{% endschema %}