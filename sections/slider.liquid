{{ 'https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css' | stylesheet_tag }}

<section
  class="hero-slider-section"
  id="HeroSlider-{{ section.id }}"
>
  <div class="swiper hero-slider">
    <div class="swiper-wrapper">
      {% for block in section.blocks %}
        <div
          class="swiper-slide hero-slide"
          {{ block.shopify_attributes }}
        >
          {% if block.settings.image != blank %}
            <picture>
              {% if block.settings.mobile_image != blank %}
                <source
                  media="(max-width: 749px)"
                  srcset="{{ block.settings.mobile_image | image_url: width: 1000 }}"
                >
              {% endif %}

              {{
                block.settings.image
                | image_url: width: 2400
                | image_tag:
                  loading: 'lazy',
                  widths: '750, 1100, 1500, 2000, 2400',
                  sizes: '100vw',
                  class: 'hero-slide-image'
              }}
            </picture>
          {% else %}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'hero-slide-image' }}
          {% endif %}

          <div
            class="
              hero-slide-content
              hero-content-{{ block.settings.content_position }}
            "
          >
            {% if block.settings.subheading != blank %}
              <p class="hero-subheading">
                {{ block.settings.subheading }}
              </p>
            {% endif %}

            {% if block.settings.heading != blank %}
              <h2 class="hero-heading">
                {{ block.settings.heading }}
              </h2>
            {% endif %}

            {% if block.settings.text != blank %}
              <div class="hero-text">
                {{ block.settings.text }}
              </div>
            {% endif %}

            {% if block.settings.button_text != blank and block.settings.button_link != blank %}
              <a
                href="{{ block.settings.button_link }}"
                class="hero-button"
              >
                {{ block.settings.button_text }}
              </a>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>

    {% if section.settings.show_arrows %}
      <div class="swiper-button-prev"></div>
      <div class="swiper-button-next"></div>
    {% endif %}

    {% if section.settings.show_dots %}
      <div class="swiper-pagination"></div>
    {% endif %}
  </div>
</section>

<style>
  #HeroSlider-{{ section.id }} {
    position: relative;
  }

  #HeroSlider-{{ section.id }} .hero-slider {
    width: 100%;
    overflow: hidden;
  }

  #HeroSlider-{{ section.id }} .hero-slide {
    position: relative;
    height: {{ section.settings.desktop_height }}px;
    overflow: hidden;
  }

  #HeroSlider-{{ section.id }} .hero-slide-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }


  /* Overlay */

  #HeroSlider-{{ section.id }} .hero-slide::after {
    content: "";
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, {{ section.settings.overlay_opacity | divided_by: 100.0 }});
    z-index: 1;
  }


  /* Content */

  #HeroSlider-{{ section.id }} .hero-slide-content {
    position: absolute;
    z-index: 2;
    max-width: 650px;
    padding: 30px;
  }


  /* Left */

  #HeroSlider-{{ section.id }} .hero-content-left {
    left: 5%;
    top: 50%;
    transform: translateY(-50%);
    text-align: left;
  }


  /* Center */

  #HeroSlider-{{ section.id }} .hero-content-center {
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
  }


  /* Right */

  #HeroSlider-{{ section.id }} .hero-content-right {
    right: 5%;
    top: 50%;
    transform: translateY(-50%);
    text-align: right;
  }


  .hero-subheading {
    margin: 0 0 10px;
    font-size: 16px;
    font-weight: 600;
    letter-spacing: 1px;
    color: #fff;
  }


  .hero-heading {
    margin: 0 0 15px;
    font-size: clamp(36px, 5vw, 72px);
    line-height: 1.05;
    color: #fff;
  }


  .hero-text {
    margin-bottom: 25px;
    font-size: 18px;
    color: #fff;
  }


  .hero-button {
    display: inline-block;
    padding: 14px 28px;
    background: #fff;
    color: #000;
    text-decoration: none;
    font-weight: 600;
    transition: 0.3s ease;
  }


  .hero-button:hover {
    background: #000;
    color: #fff;
  }


  /* Navigation */

  #HeroSlider-{{ section.id }} .swiper-button-prev,
  #HeroSlider-{{ section.id }} .swiper-button-next {
    color: #fff;
  }


  #HeroSlider-{{ section.id }} .swiper-pagination-bullet {
    background: #fff;
    opacity: 0.6;
  }


  #HeroSlider-{{ section.id }} .swiper-pagination-bullet-active {
    opacity: 1;
  }


  /* Mobile */

  @media screen and (max-width: 749px) {

    #HeroSlider-{{ section.id }} .hero-slide {
      height: {{ section.settings.mobile_height }}px;
    }

    #HeroSlider-{{ section.id }} .hero-slide-content {
      max-width: 90%;
      padding: 20px;
    }

    #HeroSlider-{{ section.id }} .hero-heading {
      font-size: 38px;
    }

    #HeroSlider-{{ section.id }} .hero-text {
      font-size: 15px;
    }

    #HeroSlider-{{ section.id }} .swiper-button-prev,
    #HeroSlider-{{ section.id }} .swiper-button-next {
      display: none;
    }

  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {

    const sliderElement = document.querySelector(
      '#HeroSlider-{{ section.id }} .hero-slider'
    );

    if (!sliderElement) return;


    new Swiper(sliderElement, {

      loop: true,

      speed: 700,

      autoplay: {
        delay: {{ section.settings.autoplay_speed }},
        disableOnInteraction: false
      },

      {% if section.settings.show_dots %}
      pagination: {
        el: '#HeroSlider-{{ section.id }} .swiper-pagination',
        clickable: true
      },
      {% endif %}

      {% if section.settings.show_arrows %}
      navigation: {
        nextEl: '#HeroSlider-{{ section.id }} .swiper-button-next',
        prevEl: '#HeroSlider-{{ section.id }} .swiper-button-prev'
      },
      {% endif %}

      touchRatio: 1,

      keyboard: {
        enabled: true
      }

    });

  });
</script>

{% schema %}
{
  "name": "Hero Slider",
  "settings": [
    {
      "type": "range",
      "id": "desktop_height",
      "label": "Desktop height",
      "min": 300,
      "max": 900,
      "step": 10,
      "default": 600,
      "unit": "px"
    },

    {
      "type": "range",
      "id": "mobile_height",
      "label": "Mobile height",
      "min": 300,
      "max": 800,
      "step": 10,
      "default": 500,
      "unit": "px"
    },

    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "default": 30,
      "unit": "%"
    },

    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Autoplay speed",
      "min": 2000,
      "max": 5000,
      "step": 500,
      "default": 4000,
      "unit": "ms"
    },

    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show arrows",
      "default": true
    },

    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show dots",
      "default": true
    }
  ],

  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Desktop image"
        },

        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile image"
        },

        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading",
          "default": "NEW COLLECTION"
        },

        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Discover Something New"
        },

        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Explore our latest collection.</p>"
        },

        {
          "type": "text",
          "id": "button_text",
          "label": "Button text",
          "default": "Shop Now"
        },

        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        },

        {
          "type": "select",
          "id": "content_position",
          "label": "Content position",
          "options": [
            {
              "value": "left",
              "label": "Left"
            },
            {
              "value": "center",
              "label": "Center"
            },
            {
              "value": "right",
              "label": "Right"
            }
          ],
          "default": "center"
        }
      ]
    }
  ],

  "presets": [
    {
      "name": "Hero Slider",

      "blocks": [
        {
          "type": "slide"
        },
        {
          "type": "slide"
        }
      ]
    }
  ]
}
{% endschema %}
