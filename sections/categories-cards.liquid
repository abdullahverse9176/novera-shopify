
{{ 'category-cards.css' | asset_url | stylesheet_tag }}

<section class="category-section">
  <div class="category-grid">

    {% for block in section.blocks %}
    <div class="category-card">
      <img
        src="{{ block.settings.image | image_url: width:600  }}"
        alt="Tops"
        width="600"
        height="800"
      >
      <a href="{{ block.settings.link }}" class="category-title">{{ block.settings.title }}</a>
    </div>
    {% endfor %}

  </div>
</section>

{% schema %}
{
  "name": "Category Cards",
  "settings": [],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Category Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Category Title",
          "default": "TOPS"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Category Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category Cards",
      "blocks": [
        {
          "type": "category"
        },
        {
          "type": "category"
        },
        {
          "type": "category"
        },
        {
          "type": "category"
        }
      ]
    }
  ]
}
{% endschema %}
