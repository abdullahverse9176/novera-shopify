<section class="category-section">
  <div class="category-grid">
    <div class="category-card">
      <img
        src="https://via.placeholder.com/600x800"
        alt="Tops"
        width="600"
        height="800"
      >
      <a href="#" class="category-title">TOPS</a>
    </div>

    <div class="category-card">
      <img
        src="https://via.placeholder.com/600x800"
        alt="Tunics"
        width="600"
        height="800"
      >
      <a href="#" class="category-title">TUNICS</a>
    </div>

    <div class="category-card">
      <img
        src="https://via.placeholder.com/600x800"
        alt="Dresses"
        width="600"
        height="800"
      >
      <a href="#" class="category-title">DRESSES</a>
    </div>

    <div class="category-card">
      <img
        src="https://via.placeholder.com/600x800"
        alt="Sweatshirts"
        width="600"
        height="800"
      >
      <a href="#" class="category-title">SWEATSHIRTS</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Category Cards",
  "settings": [],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Category Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Category Title",
          "default": "TOPS"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Category Link"
        }
      ]
    }
  ]
}
{% endschema %}
