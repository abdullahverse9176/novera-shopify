{{ 'categories-style.css' | asset_url | stylesheet_tag }}

<section class="category-section">
  <div class="category-grid">
    <div class="category-card">
      <img
        src="https://via.placeholder.com/600x800"
        alt="Tops"
        width="100"
        height="100"
      >
      <a href="#" class="category-button"> TOPS </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Category Cards",
  "settings": [],
  "blocks": [
    {
      "type": "text",
      "name": "Category Cards",
      "settings": [
        {
          "type": "image_picker",
          "id": "category_card_image",
          "label": "Category Card Image"
        },
        {
          "type": "text",
          "id": "category_card_btn",
          "label": "Category Card Button"
        }
      ]
    }
  ],
  "presets": []
}
{% endschema %}
