{{ 'categories-style.css' | asset_url | stylesheet_tag }}

<section class="category-section">
  {% if section.settings.section_title != blank %}
    <div class="section-header">
      <h2 class="section-title">{{ section.settings.section_title }}</h2>
      <p class="section-description">{{ section.settings.section_description }}</p>
    </div>
  {% endif %}

  <div class="category-grid">
    {% for block in section.blocks %}
      <div class="category-card" {{ block.shopify_attributes }}>
        {% if block.settings.image != blank %}
          <img
            src="{{ block.settings.image | image_url: width: 600 }}"
            alt="{{ block.settings.title | default: 'Category Showcase' | escape }}"
            width="600"
            height="800"
            loading="lazy"
          >
        {% else %}
          <div style="width:100%;height:100%;background:#dedcd8;display:flex;align-items:center;justify-content:center;color:#111111;font-weight:600;">
            {{ block.settings.title | default: 'Category' | escape }}
          </div>
        {% endif %}
        <a
          href="{% if block.settings.link != blank %}{{ block.settings.link }}{% else %}javascript:void(0){% endif %}"
          class="category-title"
          aria-label="{{ block.settings.title | default: 'Category' | escape }}"
          title="{{ block.settings.title | default: 'Category' | escape }}"
        >
          {{- block.settings.title | default: 'Collection' -}}
        </a>
      </div>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Category Cards",
  "settings": [
    {
      "type": "text",
      "id": "section_title",
      "label": "Category Title",
      "default": "Categories"
    },
    {
      "type": "text",
      "id": "section_description",
      "label": "Category Description",
      "default": "Category Description"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Category Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Category Title",
          "default": "TOPS"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Category Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category Cards",
      "blocks": [
        {
          "type": "category"
        },
        {
          "type": "category"
        },
        {
          "type": "category"
        },
        {
          "type": "category"
        }
      ]
    }
  ]
}
{% endschema %}
