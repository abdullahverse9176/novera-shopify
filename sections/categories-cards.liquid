<section class="category-section">
  <div class="category-grid">
    
    <div class="category-card">
      <img
        src="{{ }}"
        alt="Tops"
        width="600"
        height="800"
      >
      <a href="#" class="category-title">TOPS</a>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Category Cards",
  "settings": [],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Category Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Category Title",
          "default": "TOPS"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Category Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category Cards",
      "blocks": [
        {
          "type": "category"
        },
        {
          "type": "category"
        },
        {
          "type": "category"
        },
        {
          "type": "category"
        }
      ]
    }
  ]
}
{% endschema %}
