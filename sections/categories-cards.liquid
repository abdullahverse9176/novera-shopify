{{ 'categories-style.css' | asset_url | stylesheet_tag }}

<section class="category-section">
  <div class="category-grid">
    {% for block in section.blocks %}
      <div class="category-card">
        {% if block.settings.category_card_image %}
          <div class="card-img">
            <img
              src="{{ block.settings.category_card_image | image_url }}"
              alt="Tops"
              width="250"
              height="200"
            >
          </div>
        {% else %}
          <div class="card-img">
            <img
              src="https://cdn.shopify.com/s/files/1/0533/2089/files/placeholder-images-product-5_large.png?v=1530129458"
              alt="Tops"
              width="250"
              height="200"
            >
          </div>
        {% endif %}

        {% if block.settings.category_card_btn != blank %}
          <div class="btn-wrapper">
            <a href="{{block.settings.category_card_url}}" class="category-button">
              {{ block.settings.category_card_btn }}
            </a>
          </div>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Category Cards",
  "blocks": [
    {
      "type": "category",
      "name": "Category Cards",
      "settings": [
        {
          "type": "image_picker",
          "id": "category_card_image",
          "label": "Category Card Image"
        },
        {
          "type": "text",
          "id": "category_card_btn",
          "label": "Category Card Button"
        },
        {
          "type": "url",
          "id": "category_card_url",
          "label": "Category Card URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category Section",
      "blocks": [
        {
          "type": "category"
        },
        {
          "type": "category"
        },
        {
          "type": "category"
        },
        {
          "type": "category"
        }
      ]
    }
  ]
}
{% endschema %}
