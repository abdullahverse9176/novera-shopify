{{ 'categories-style.css' | asset_url | stylesheet_tag }}

<section class="category-section">
  <div class="category-grid">
    <div class="category-card">
      <img
        src="{{ block.settings.category_card_image | image_url }}"
        alt="Tops"
        width="100"
        height="100"
      >
      <a href="#" class="category-button"> TOPS </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Category Cards",
  "blocks": [
    {
      "type": "category",
      "name": "Category Cards",
      "settings": [
        {
          "type": "image_picker",
          "id": "category_card_image",
          "label": "Category Card Image"
        },
        {
          "type": "text",
          "id": "category_card_btn",
          "label": "Category Card Button"
        },
        {
          "type": "url",
          "id": "category_card_url",
          "label": "Category Card URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category Section",
      "blocks": [
        {
          "type": "category"
        },
        {
          "type": "category"
        },
        {
          "type": "category"
        },
        {
          "type": "category"
        }
      ]
    }
  ]
}
{% endschema %}
