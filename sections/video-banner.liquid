<style>
  .video-section {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  .video-section video,
  .video-section iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border: 0;
  }
</style>

<section class="video-section">

  {% if section.settings.banner_video != blank %}

    {{ section.settings.banner_video | video_tag:
      autoplay: true,
      loop: true,
      muted: true,
      controls: false
    }}

  {% elsif section.settings.video_url != blank %}

    {{ section.settings.video_url | external_video_tag }}

  {% endif %}

</section>

{% schema %}
{
  "name": "Video Section",
  "settings": [
    {
      "type": "video",
      "id": "banner_video",
      "label": "Banner Video"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "label": "Video URL",
      "accept": [
        "youtube",
        "vimeo"
      ]
    }
  ],
  "presets": [
    {
      "name": "Video Section"
    }
  ]
}
{% endschema %}