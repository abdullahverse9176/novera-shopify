<style>
      .video-section {
    position: relative;
    padding-top: 56%
  }

  .video-section video {
      position: absolute;
      top:0;
      left: 0;
      width: 100%;
      height: 100%;
      object-fit:cover;
  }
</style>
<section class="video-section">
    {{ section.settings.banner_video | video_tag }}
</section>

{% schema %}
{
  "name": "Video Section",
  "settings": [
    {
      "type": "video",
      "id": "banner_video",
      "label": "Banner Video"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "label": "Video URL",
      "accept": ["youtube", "vimeo"]
    }
  ],
  "presets": [
    {
      "name": "Video Section"
    }
  ]
}
{% endschema %}
