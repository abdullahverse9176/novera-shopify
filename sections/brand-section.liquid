{{ 'brand-section.css' | asset_url | stylesheet_tag }}

<section class="brand-section">
  <div class="brand-header">
    <p class="brand-subtitle">OUR PARTNERS</p>

    <h2 class="brand-title">Brands We Love</h2>
  </div>

  <div class="brand-grid">
    {% for block in section.blocks %}
      {% if block.settings.brand_logo != blank %}
        <div class="brand-card">
          <img
            src="https://media.istockphoto.com/id/2173059563/vector/coming-soon-image-on-white-background-no-photo-available.jpg?s=612x612&w=0&k=20&c=v0a_B58wPFNDPULSiw_BmPyhSNCyrP_d17i2BPPyDTk="
            alt="Brand 1"
          >
        </div>
      {% endif %}

    {% else %}
      <div class="brand-card">
        <img
          src="https://media.istockphoto.com/id/2173059563/vector/coming-soon-image-on-white-background-no-photo-available.jpg?s=612x612&w=0&k=20&c=v0a_B58wPFNDPULSiw_BmPyhSNCyrP_d17i2BPPyDTk="
          alt="Brand 1"
        >
      </div>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Brand Section",
  "settings": [],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand Section",
      "settings": [
        {
          "type": "image_picker",
          "id": "brand_logo",
          "label": "Brand Logo"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brand Section",
      "blocks": [
        {
          "type": "brand"
        }
      ]
    }
  ]
}
{% endschema %}
