
{{ 'hero-banner.css' | asset_url | stylesheet_tag }}

<section class="hero-section">

  <div class="hero-image">
    <img
      src="{{ section.settings.hero_image | image_url }}"
      alt="New Collection"
      width="1600"
      height="800"
    >
  </div>

  <div class="hero-content">

    <p class="hero-subtitle">
      {{ section.settings.header_subtitle }}
    </p>

    <h1 class="hero-title">
      {{ section.settings.header_title }}
    </h1>

    <p class="hero-description">
      {{ section.settings.hero_description }}
    </p>

    <div class="hero-buttons">

      <a href="{{ section.settings.hero_hero_primary_btn_url }}" class="hero-button hero-button-primary">
        {{ section.settings.hero_hero_primary_btn }}
      </a>

      <a href="{{ section.settings.hero_hero_secondary_btn_url }}" class="hero-button hero-button-secondary">
        {{ section.settings.hero_hero_secondary_btn }}
      </a>

    </div>

  </div>

</section>

{% schema %}
 {
  "name": "hero-banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Image",
    },
    {
      "type": "text",
      "id": "header_subtitle",
      "label": "Hero Subtitle",
      "default": "NEW COLLECTION"
    },
    {
      "type": "text",
      "id": "header_title",
      "label": "Hero Title",
      "default": "Discover Our Latest Collection"
    },
    {
      "type": "textarea",
      "id": "hero_description",
      "label": "Hero Description",
      "default": "Explore timeless styles made for everyday living."
    },
    {
      "type": "text",
      "id": "hero_hero_primary_btn",
      "label": "Hero Primary Button",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "hero_hero_primary_btn_url",
      "label": "Hero Primary Button URL",
    },
    {
      "type": "text",
      "id": "hero_hero_secondary_btn",
      "label": "Hero secondary Button",
      "default": "VIEW COLLECTION"
    },
    {
      "type": "url",
      "id": "hero_hero_secondary_btn_url",
      "label": "Hero secondary Button URL",
    },
  ],
  "presets": []
}
{% endschema %}