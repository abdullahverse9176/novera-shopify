
{{ 'hero-banner.css' | asset_url | stylesheet_tag }}

<section class="hero-section">

  <div class="hero-image">
    <img
      src="https://via.placeholder.com/1600x800"
      alt="New Collection"
      width="1600"
      height="800"
    >
  </div>

  <div class="hero-content">

    <p class="hero-subtitle">
      {{ section.settings.header_subtitle }}
    </p>

    <h1 class="hero-title">
      {{ section.settings.header_title }}
    </h1>

    <p class="hero-description">
      {{ section.settings.hero_description }}
    </p>

    <div class="hero-buttons">

      <a href="#" class="hero-button hero-button-primary">
        SHOP NOW
      </a>

      <a href="#" class="hero-button hero-button-secondary">
        VIEW COLLECTION
      </a>

    </div>

  </div>

</section>

{% schema %}
 {
  "name": "hero-banner",
  "settings": [
    {
      "type": "text",
      "id": "header_subtitle",
      "label": "Hero Subtitle",
      "default": "NEW COLLECTION"
    },
    {
      "type": "text",
      "id": "header_title",
      "label": "Hero Title",
      "default": "Discover Our Latest Collection"
    },
    {
      "type": "textarea",
      "id": "hero_description",
      "label": "Hero Description",
      "default": "Explore timeless styles made for everyday living."
    }
  ],
  "presets": []
}
{% endschema %}