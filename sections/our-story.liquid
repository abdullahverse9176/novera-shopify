{{ 'our-story.css' | asset_url | stylesheet_tag }}

<section class="image-text-section">
  <div class="image-text-image">
    <img
      src="{section.settings.story-image}"
      alt="Our Story"
      width="800"
      height="900"
    >
  </div>

  <div class="image-text-image">
    <img
      src="https://images.unsplash.com/photo-1591047139829-d91aecb6caea?q=80&w=436&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D"
      alt="Our Story"
      width="800"
      height="900"
    >
  </div>

  <div class="image-text-content">
    <p class="image-text-subtitle">OUR STORY</p>

    <h2 class="image-text-title">Designed With You In Mind</h2>

    <p class="image-text-description">
      We create timeless pieces that combine comfort, quality and modern design for everyday life.
    </p>

    <a href="#" class="image-text-button"> LEARN MORE </a>
  </div>
</section>

{% schema %}
{
  "name": "Our Story",
  "settings": [
    {
      "type": "image_picker",
      "id": "story-image",
      "label": "Our Story Image",
    },
    {
      "type": "text",
      "id": "story-subtitle",
      "label": "Our Story Subtitle",
      "default": "OUR STORY"
    },
    {
      "type": "text",
      "id": "story-title",
      "label": "Our Story Title",
      "default": "Designed With You In Mind"
    },
    {
      "type": "textarea",
      "id": "story-description",
      "label": "Our Story Description"
    }
  ],
  "presets": [
    {
      "name": "Our Story"
    }
  ]
}
{% endschema %}
