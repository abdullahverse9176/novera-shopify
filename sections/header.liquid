{% comment %}
  Header Section
  Features: Sticky navigation, announcement bar, logo, accessible links, mobile drawer
{% endcomment %}

{% if section.settings.show_announcement %}
  <aside class="announcement-bar" role="region" aria-label="Announcement">
    <div class="container">
      <span>
        {{- section.settings.announcement_text | default: 'Free worldwide express shipping on all orders over $75!' -}}
      </span>
      {% if section.settings.announcement_link != blank %}
        <a
          href="{{ section.settings.announcement_link }}"
          class="announcement-bar__link"
          aria-label="{{ section.settings.announcement_link_text | default: 'Learn More' }}"
          title="{{ section.settings.announcement_link_text | default: 'Learn More' }}"
        >
          {{ section.settings.announcement_link_text | default: 'Learn More' }}
        </a>
      {% endif %}
    </div>
  </aside>
{% endif %}

<header role="banner" class="site-header">
  <div class="container">
    <div class="site-header__inner">
      <!-- Store Brand / Logo -->
      <div class="site-header__logo">
        <a
          href="/"
          class="site-header__logo-link"
          aria-label="{{ shop.name | escape }} Homepage"
          title="{{ shop.name | escape }} Homepage"
        >
          {% if section.settings.logo != blank %}
            <img
              src="{{ section.settings.logo | image_url: width: 300 }}"
              alt="{{ section.settings.logo.alt | default: shop.name | escape }}"
              class="site-header__logo-img"
              width="{{ section.settings.logo_width | default: 140 }}"
              height="auto"
              loading="eager"
            >
          {% else %}
            <span>{{ shop.name | default: 'NOVERA' }}</span>
          {% endif %}
        </a>
      </div>

      <!-- Desktop Navigation -->
      <nav role="navigation" class="site-nav" aria-label="Main Navigation">
        {% render 'navigation-menu',
          menu: linklists[section.settings.menu],
          nav_class: 'site-nav__list',
          link_class: 'site-nav__link'
        %}
      </nav>

      <!-- Action Items & Mobile Menu Trigger -->
      <div class="site-header__actions">
        <a
          href="{% if routes.search_url %}{{ routes.search_url }}{% else %}javascript:void(0){% endif %}"
          class="site-header__action-btn"
          id="header_search"
          aria-label="Search the store"
          title="Search the store"
        >
          {% render 'icons', icon: 'search' %}
        </a>

        <!-- Search Modal -->
        <div
          class="search-modal"
          id="searchModal"
          hidden
          aria-hidden="true"
        >
          <!-- Overlay -->
          <div
            class="search-modal__overlay"
            data-search-close
          ></div>

          <!-- Modal -->
          <div
            class="search-modal__dialog"
            role="dialog"
            aria-modal="true"
            aria-labelledby="searchModalTitle"
          >
            <!-- Header -->
            <div class="search-modal__header">
              <h2
                class="search-modal__title"
                id="searchModalTitle"
              >
                Search Products
              </h2>

              <button
                type="button"
                class="search-modal__close"
                data-search-close
                aria-label="Close search"
              >
                &times;
              </button>
            </div>

            <!-- Search Form -->
            <div class="search-modal__body">
              <form
                class="search-modal__form"
                id="searchForm"
              >
                <div class="search-modal__input-wrapper">
                  <span class="search-modal__icon">
                    {% render 'icons', icon: 'search' %}
                  </span>

                  <input
                    type="search"
                    id="searchInput"
                    class="search-modal__input"
                    placeholder="Search products..."
                    autocomplete="off"
                    aria-label="Search products"
                  >
                </div>

                <button
                  type="submit"
                  class="search-modal__submit"
                >
                  Search
                </button>
              </form>

              <!-- Search Results -->
              <div
                class="search-modal__results"
                id="searchResults"
              >
                <div class="search-modal__empty">
                  <p>Search for products</p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <a
          href="{% if routes.cart_url %}{{ routes.cart_url }}{% else %}javascript:void(0){% endif %}"
          class="site-header__action-btn"
          aria-label="View shopping cart with {{ cart.item_count | default: 0 }} items"
          title="View shopping cart with {{ cart.item_count | default: 0 }} items"
        >
          {% render 'icons', icon: 'cart' %}
          <span class="site-header__badge" aria-hidden="true">{{ cart.item_count | default: 0 }}</span>
        </a>

        <button
          type="button"
          class="site-header__hamburger"
          data-mobile-menu-trigger
          aria-label="Open navigation menu"
          title="Open navigation menu"
          aria-expanded="false"
        >
          {% render 'icons', icon: 'menu' %}
        </button>
      </div>
    </div>
  </div>
</header>

<!-- Accessible Mobile Navigation Drawer -->
<div class="mobile-nav-drawer" data-mobile-drawer aria-hidden="true">
  <div class="mobile-nav-drawer__overlay" data-mobile-drawer-overlay></div>
  <nav class="mobile-nav-drawer__content" aria-label="Mobile Navigation">
    <div class="mobile-nav-drawer__header">
      <span class="site-header__logo-link">
        <span class="site-header__logo-badge" aria-hidden="true"></span>
        {{ shop.name | default: 'NOVERA' }}
      </span>
      <button
        type="button"
        class="mobile-nav-drawer__close"
        data-mobile-drawer-close
        aria-label="Close navigation menu"
        title="Close navigation menu"
      >
        {% render 'icons', icon: 'close' %}
      </button>
    </div>

    {% render 'navigation-menu',
      menu: linklists[section.settings.menu],
      nav_class: 'mobile-nav-drawer__list',
      link_class: 'mobile-nav-drawer__link'
    %}
  </nav>
</div>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "header",
      "content": "Announcement Bar"
    },
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show announcement bar",
      "default": true
    },
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Announcement text",
      "default": "Free worldwide express shipping on all orders over $75!"
    },
    {
      "type": "url",
      "id": "announcement_link",
      "label": "Announcement link"
    },
    {
      "type": "text",
      "id": "announcement_link_text",
      "label": "Announcement link text",
      "default": "Learn More"
    },
    {
      "type": "header",
      "content": "Branding & Navigation"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Store Logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 80,
      "max": 260,
      "step": 10,
      "unit": "px",
      "label": "Logo width",
      "default": 140
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Main Menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}

<script>
  
  document.addEventListener("DOMContentLoaded", () => {

  const searchButton = document.querySelector("#header_search");
  const searchModal = document.querySelector("#searchModal");
  const searchInput = document.querySelector("#searchInput");
  const searchForm = document.querySelector("#searchForm");
  const searchResults = document.querySelector("#searchResults");
  const closeButtons = document.querySelectorAll("[data-search-close]");

  if (!searchButton || !searchModal || !searchInput) {
    return;
  }


  /* =========================
     OPEN SEARCH MODAL
  ========================= */

  searchButton.addEventListener("click", (event) => {

    event.preventDefault();

    searchModal.hidden = false;
    searchModal.setAttribute("aria-hidden", "false");

    searchInput.focus();

  });


  /* =========================
     CLOSE SEARCH MODAL
  ========================= */

  closeButtons.forEach((button) => {

    button.addEventListener("click", () => {

      searchModal.hidden = true;
      searchModal.setAttribute("aria-hidden", "true");

      searchInput.value = "";
      searchResults.innerHTML = "";

    });

  });


  /* =========================
     SEARCH
  ========================= */

  searchForm.addEventListener("submit", (event) => {

    event.preventDefault();

    searchProducts(searchInput.value.trim());

  });


  /* =========================
     LIVE SEARCH
  ========================= */

  searchInput.addEventListener("input", () => {

    const query = searchInput.value.trim();

    if (query.length < 2) {

      searchResults.innerHTML = `
        <div class="search-modal__empty">
          <p>Search for products</p>
        </div>
      `;

      return;

    }

    searchProducts(query);

  });


  /* =========================
     AJAX FUNCTION
  ========================= */

  async function searchProducts(query) {

    searchResults.innerHTML = `
      <div class="search-loading">
        Searching...
      </div>
    `;

    try {

      const url =
        window.Shopify.routes.root +
        "search/suggest.json?q=" +
        encodeURIComponent(query) +
        "&resources[type]=product" +
        "&resources[limit]=8";

      const response = await fetch(url, {
        headers: {
          "Accept": "application/json"
        }
      });

      if (!response.ok) {
        throw new Error("Search request failed");
      }

      const data = await response.json();

      console.log("Search response:", data);

      const products =
        data.resources?.results?.products || [];

      renderProducts(products);

    } catch (error) {

      console.error("Search error:", error);

      searchResults.innerHTML = `
        <div class="search-no-results">
          <p>Something went wrong. Please try again.</p>
        </div>
      `;

    }

  }


  /* =========================
     DYNAMIC HTML
  ========================= */

  function renderProducts(products) {

    if (!products.length) {

      searchResults.innerHTML = `
        <div class="search-no-results">
          <p>No products found</p>
        </div>
      `;

      return;

    }


    searchResults.innerHTML = products.map((product) => {

      const image = product.image
        ? product.image
        : "";

      const price = product.price
        ? product.price
        : "";

      return `
        <a
          href="${product.url}"
          class="search-product"
        >

          ${
            image
              ? `
                <img
                  src="${image}"
                  alt="${escapeHTML(product.title)}"
                  class="search-product__image"
                  loading="lazy"
                  width="70"
                  height="70"
                >
              `
              : ""
          }

          <div class="search-product__info">

            <h3 class="search-product__title">
              ${escapeHTML(product.title)}
            </h3>

            <p class="search-product__price">
              ${price}
            </p>

          </div>

        </a>
      `;

    }).join("");

  }


  /* =========================
     ESCAPE HTML
  ========================= */

  function escapeHTML(value) {

    const div = document.createElement("div");

    div.textContent = value;

    return div.innerHTML;

  }


  /* =========================
     ESC KEY
  ========================= */

  document.addEventListener("keydown", (event) => {

    if (event.key === "Escape" && !searchModal.hidden) {

      searchModal.hidden = true;
      searchModal.setAttribute("aria-hidden", "true");

    }

  });

});

</script>
