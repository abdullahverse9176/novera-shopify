<section class="faq-section">
  <div class="faq-container">
    <div class="faq-header">
      <p class="faq-subtitle">FAQ</p>

      <h2 class="faq-title">Frequently Asked Questions</h2>

      <p class="faq-description">Find answers to some of our most common questions.</p>
    </div>

    <div class="faq-list">
      {% for block in blocks %}
        <details class="faq-item">
          <summary class="faq-question">
            {{block.settings.faq-question}}
            <span class="faq-icon">+</span>
          </summary>

          <div class="faq-answer">
            <p>Orders are usually delivered within 3–5 business days.</p>
          </div>
        </details>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Faq Section",
  "blocks": [
    {
      "type": "faq-item",
      "name": "Faq Section",
      "settings": [
        {
          "type": "text",
          "id": "faq-question",
          "label": "FAQ Question"
        },
        {
          "type": "text",
          "id": "faq-answer",
          "label": "FAQ Answer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ Section",
      "blocks": [
        {
          "type": "faq-item"
        }
      ]
    }
  ]
}
{% endschema %}
