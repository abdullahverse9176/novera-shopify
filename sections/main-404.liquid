{% comment %}
  404 Not Found Section
{% endcomment %}

<section class="section-404" style="padding: 100px 0; text-align: center;">
  <div class="container">
    <span class="section-header__badge" style="color: var(--btn-cyan); font-weight: 700; font-size: 14px; text-transform: uppercase; letter-spacing: 2px;">Error 404</span>
    <h2 style="font-size: 48px; margin: 16px 0 20px; color: var(--white-color);">Page Not Found</h2>
    <p style="color: var(--text-muted-dark); max-width: 500px; margin: 0 auto 32px; font-size: 16px;">
      The page you were searching for does not exist, has been removed, or is temporarily unavailable.
    </p>
    <a
      href="/"
      class="btn-primary-pill"
      aria-label="Return to homepage"
      title="Return to homepage"
    >
      Return To Homepage
    </a>
  </div>
</section>

{% schema %}
{
  "name": "404 Page",
  "settings": []
}
{% endschema %}
