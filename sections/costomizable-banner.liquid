{{ 'customizable-banner.css' | asset_url | stylesheet_tag }}

<section class="custom-banner" style="padding: {{ section.settings.padding }}px 30px; background-color: {{ section.settings.background_color }};">
  <div class="custom-banner-content {{ section.settings.text_position }}">
    <p class="custom-banner-subtitle">SPECIAL OFFER</p>

    <h2 class="custom-banner-title">Up to 50% Off</h2>

    {% if section.settings.show_button %}
      <a href="#" class="custom-banner-button">SHOP NOW</a>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Customizable Banner",
  "settings": [
    {
      "type": "select",
      "id": "text_position",
      "label": "Text Position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "label": "Show Button",
      "default": true
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Banner Padding",
      "min": 40,
      "max": 150,
      "step": 10,
      "default": 100,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#eeeeee"
    }
  ],
  "presets": [
    {
      "name": "Customizable Banner"
    }
  ]
}
{% endschema %}


