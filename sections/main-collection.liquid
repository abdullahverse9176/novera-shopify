{{ 'main-collection.css' | asset_url | stylesheet_tag }}

<div class="collection-toolbar">

  <button type="button" class="filter-toggle">
    Filters
  </button>

</div>


<div class="collection-layout">

  <!-- =========================
       FILTERS
  ========================== -->

  <aside class="collection-filters">

    <form method="get">

      {% for filter in collection.filters %}

        <div class="filter-group">

          <h3 class="filter-title">
            {{ filter.label }}
          </h3>


          <!-- PRICE FILTER -->

          {% if filter.type == 'price_range' %}

            <div class="price-filter">

              <div class="price-field">

                <label for="price-min">
                  Min
                </label>

                <input
                  id="price-min"
                  type="number"
                  name="{{ filter.min_value.param_name }}"
                  value="{{ filter.min_value.value | divided_by: 100 }}"
                  placeholder="0"
                >

              </div>


              <div class="price-field">

                <label for="price-max">
                  Max
                </label>

                <input
                  id="price-max"
                  type="number"
                  name="{{ filter.max_value.param_name }}"
                  value="{{ filter.max_value.value | divided_by: 100 }}"
                  placeholder="10000"
                >

              </div>

            </div>


          <!-- OTHER FILTERS -->

          {% else %}

            {% for value in filter.values %}

              <label class="filter-option">

                <input
                  type="checkbox"
                  name="{{ value.param_name }}"
                  value="{{ value.value }}"
                  {% if value.active %}
                    checked
                  {% endif %}
                >

                <span>
                  {{ value.label }}
                </span>

                <small>
                  {{ value.count }}
                </small>

              </label>

            {% endfor %}

          {% endif %}

        </div>

      {% endfor %}


      <button type="submit">
        Apply Filters
      </button>
      <a
  href="{{ collection.url }}"
  class="clear-filters"
>
  Clear Filters
</a>

    </form>

  </aside>


  <!-- =========================
       COLLECTION CONTENT
  ========================== -->

  <section class="main-collection">

    <div class="main-collection__container">


      <!-- Collection Header -->

      <div class="collection-header">

        <h1 class="collection-title">
          {{ collection.title }}
        </h1>


        {% if collection.description != blank %}

          <div class="collection-description">
            {{ collection.description }}
          </div>

        {% endif %}

      </div>


      <!-- Products -->

      {% if collection.products_count > 0 %}

        <div class="collection-grid">

          {% for product in collection.products %}

            <article class="product-card">


              <!-- Product Image -->

              <div class="product-card__image">

                <a href="{{ product.url }}">

                  {% if product.featured_image != blank %}

                    {{
                      product.featured_image
                      | image_url: width: 600
                      | image_tag:
                        loading: 'lazy',
                        alt: product.title
                    }}

                  {% else %}

                    {{ 'product-1' | placeholder_svg_tag }}

                  {% endif %}

                </a>

              </div>


              <!-- Product Information -->

              <div class="product-card__content">

                <h2 class="product-card__title">

                  <a href="{{ product.url }}">
                    {{ product.title }}
                  </a>

                </h2>


                <div class="product-card__price">
                  {{ product.price | money }}
                </div>


                {% if product.available %}

                  <span class="product-card__availability">
                    Available
                  </span>

                {% else %}

                  <span class="product-card__availability product-card__availability--sold">
                    Sold Out
                  </span>

                {% endif %}

              </div>

            </article>

          {% endfor %}

        </div>


      {% else %}

        <div class="collection-empty">

          <h2>
            There's no product in this collection.
          </h2>

        </div>

      {% endif %}

    </div>

  </section>

</div>


{% schema %}

{
  "name": "Main Collection",
  "settings": []
}

{% endschema %}