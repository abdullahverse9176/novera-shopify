{{ 'main-collection.css' | asset_url | stylesheet_tag }}

<div class="collection-toolbar">

  <button
    type="button"
    class="filter-toggle"
  >
    Filters
  </button>

</div>


<div class="collection-layout">

  <!-- =================================
       FILTER SIDEBAR
  ================================== -->

  <div class="collection-header">

        <h1 class="collection-title">
          {{ collection.title }}
        </h1>


        {% if collection.description != blank %}

          <div class="collection-description">
            {{ collection.description }}
          </div>

        {% endif %}

      </div>

  <aside class="collection-filters">

    <form method="get">

      {% for filter in collection.filters %}

        <div class="filter-group">

          <h3 class="filter-title">
            {{ filter.label }}
          </h3>


          <!-- =================================
               AVAILABILITY FILTER
          ================================== -->

          {% if filter.type == 'boolean' %}

            {% if filter.true_value != blank %}

              <label class="filter-option">

                <input
                  type="checkbox"
                  name="{{ filter.param_name }}"
                  value="{{ filter.true_value.value }}"
                  {% if filter.true_value.active %}
                    checked
                  {% endif %}
                  {% if filter.true_value.count == 0 and filter.true_value.active == false %}
                    disabled
                  {% endif %}
                >

                <span>
                  {{ filter.true_value.label }}
                </span>

                <small>
                  {{ filter.true_value.count }}
                </small>

              </label>

            {% endif %}


            {% if filter.false_value != blank %}

              <label class="filter-option">

                <input
                  type="checkbox"
                  name="{{ filter.param_name }}"
                  value="{{ filter.false_value.value }}"
                  {% if filter.false_value.active %}
                    checked
                  {% endif %}
                  {% if filter.false_value.count == 0 and filter.false_value.active == false %}
                    disabled
                  {% endif %}
                >

                <span>
                  {{ filter.false_value.label }}
                </span>

                <small>
                  {{ filter.false_value.count }}
                </small>

              </label>

            {% endif %}


          <!-- =================================
               PRICE FILTER
          ================================== -->

          {% elsif filter.type == 'price_range' %}

            <div class="price-filter">

              <div class="price-field">

                <label for="price-min">
                  Min
                </label>

                <input
                  id="price-min"
                  type="number"
                  name="{{ filter.min_value.param_name }}"
                  {% if filter.min_value.value %}
                    value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}"
                  {% endif %}
                  placeholder="0"
                  min="0"
                  max="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                >

              </div>


              <div class="price-field">

                <label for="price-max">
                  Max
                </label>

                <input
                  id="price-max"
                  type="number"
                  name="{{ filter.max_value.param_name }}"
                  {% if filter.max_value.value %}
                    value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}"
                  {% endif %}
                  placeholder="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                  min="0"
                  max="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                >

              </div>

            </div>


          <!-- =================================
               LIST FILTERS
               Color / Size / Vendor / Type etc.
          ================================== -->

          {% elsif filter.type == 'list' %}

            {% for value in filter.values %}

              <label class="filter-option">

                <input
                  type="checkbox"
                  name="{{ value.param_name }}"
                  value="{{ value.value }}"
                  {% if value.active %}
                    checked
                  {% endif %}
                  {% if value.count == 0 and value.active == false %}
                    disabled
                  {% endif %}
                >

                <span>
                  {{ value.label }}
                </span>

                <small>
                  {{ value.count }}
                </small>

              </label>

            {% endfor %}

          {% endif %}

        </div>

      {% endfor %}


      <!-- =================================
           APPLY BUTTON
      ================================== -->

      <button
        type="submit"
        class="apply-filters"
      >
        Apply Filters
      </button>


      <!-- =================================
           CLEAR FILTERS
      ================================== -->

      <a
        href="{{ collection.url }}"
        class="clear-filters"
      >
        Clear Filters
      </a>

    </form>

  </aside>


  <!-- =================================
       COLLECTION CONTENT
  ================================== -->

  <section class="main-collection">

    <div class="main-collection__container">


      <!-- =================================
           COLLECTION HEADER
      ================================== -->

      <div class="collection-header">

        <h1 class="collection-title">
          {{ collection.title }}
        </h1>


        {% if collection.description != blank %}

          <div class="collection-description">
            {{ collection.description }}
          </div>

        {% endif %}

      </div>


      <!-- =================================
           PRODUCTS
      ================================== -->

      {% if collection.products_count > 0 %}

        <div class="collection-grid">

          {% for product in collection.products %}

            <article class="product-card">


              <!-- PRODUCT IMAGE -->

              <div class="product-card__image">

                <a href="{{ product.url }}">

                  {% if product.featured_image != blank %}

                    {{
                      product.featured_image
                      | image_url: width: 600
                      | image_tag:
                        loading: 'lazy',
                        alt: product.title
                    }}

                  {% else %}

                    {{ 'product-1' | placeholder_svg_tag }}

                  {% endif %}

                </a>

              </div>


              <!-- PRODUCT CONTENT -->

              <div class="product-card__content">

                <h2 class="product-card__title">

                  <a href="{{ product.url }}">
                    {{ product.title }}
                  </a>

                </h2>


                <div class="product-card__price">
                  {{ product.price | money }}
                </div>


                {% if product.available %}

                  <span class="product-card__availability">
                    Available
                  </span>

                {% else %}

                  <span class="product-card__availability product-card__availability--sold">
                    Sold Out
                  </span>

                {% endif %}

              </div>

            </article>

          {% endfor %}

        </div>


      {% else %}

        <!-- NO PRODUCTS -->

        <div class="collection-empty">

          <h2>
            There's no product in this collection.
          </h2>

          <a
            href="{{ collection.url }}"
            class="clear-filters"
          >
            Clear Filters
          </a>

        </div>

      {% endif %}

    </div>

  </section>

</div>


{% schema %}

{
  "name": "Main Collection",
  "settings": []
}

{% endschema %}